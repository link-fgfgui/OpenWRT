From: build fix
Subject: [PATCH] unisocwifi: use the right dir_context actor type on Linux 5.15

filldir_t returns int until Linux 6.16, where it became bool. The driver
assumed bool for every kernel >= 3.19, so OpenWrt 23.05 (5.15) fails with
-Werror=incompatible-pointer-types on wcn_parn_parser.c.

---
--- a/unisocwcn/platform/wcn_parn_parser.c
+++ b/unisocwcn/platform/wcn_parn_parser.c
@@ -152,11 +152,11 @@
 			return (unsigned char)*prefix - (unsigned char)*str;
 }
 
-#if KERNEL_VERSION(3, 19, 0) <= LINUX_VERSION_CODE
+#if KERNEL_VERSION(6, 16, 0) <= LINUX_VERSION_CODE
 static bool find_callback(struct dir_context *ctx, const char *name, int namlen,
 		     loff_t offset, u64 ino, unsigned int d_type)
 #else
-static int find_callback(void *ctx, const char *name, int namlen,
+static int find_callback(struct dir_context *ctx, const char *name, int namlen,
 		     loff_t offset, u64 ino, unsigned int d_type)
 #endif
 {
